NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nirvan_settlement

SHOPIFY_SHOP=t91jg6-qq.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ADMIN_TOKEN=
# (optional cache/fallback; filled automatically after OAuth)
SCOPES=read_orders,read_products,read_fulfillments,read_merchant_managed_fulfillment_orders

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

APPROVER_EMAILS=admin@nirvanearth.com
NOTIFY_EMAIL=admin@nirvanearth.com
EMAIL_FROM=settlement@localhost
RESEND_API_KEY=

RETURN_WINDOW_DAYS=14
COMMISSION_RATE=0.20
PLATFORM_OWN_TAGS=nirvan-own,gift-hamper
PLATFORM_OWN_VENDOR_NAMES=Nirvan Earth
PLATFORM_OWN_PRODUCT_IDS=

APP_URL=http://localhost:3000
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-session

# Live transfers stay off until a written go-live email from admin@nirvanearth.com.
# Set both only after that email. Either one is enough to allow a live key to boot.
# ALLOW_LIVE=true
# ALLOW_LIVE_TRANSFERS=true
